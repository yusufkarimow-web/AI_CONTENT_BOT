# ============================================================================
# SECURITY SETTINGS
# ============================================================================
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data-32-chars
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token-32-chars

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
DATABASE_URL=postgresql+asyncpg://tojikai_user:secure_password@db:5432/tojikai_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# REDIS SETTINGS
# ============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=secure_redis_password
REDIS_DB=0

# ============================================================================
# TELEGRAM BOT SETTINGS
# ============================================================================
BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=your_bot_username
RUN_MODE=webhook  # webhook or polling
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
PUBLIC_BASE_URL=https://api.tojikai.app
TELEGRAM_ALLOWED_UPDATES=message,callback_query,inline_query

# ============================================================================
# OPENAI API SETTINGS
# ============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ============================================================================
# PAYMENT GATEWAY SETTINGS
# ============================================================================

# Click (Узбекистан)
CLICK_SERVICE_ID=12345
CLICK_MERCHANT_ID=123456
CLICK_SECRET_KEY=your_click_secret_key
CLICK_API_URL=https://api.click.uz/v2

# Payme (Узбекистан)
PAYME_MERCHANT_ID=6xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYME_SECRET_KEY=your_payme_secret_key
PAYME_API_URL=https://checkout.paycom.uz/api

# Alif (Таджикистан)
ALIF_MERCHANT_ID=your_alif_merchant_id
ALIF_SECRET_KEY=your_alif_secret_key
ALIF_API_URL=https://api.alif.tj/v1

# ============================================================================
# WHATSAPP INTEGRATION (Green-API)
# ============================================================================
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=your_instance_id
WHATSAPP_API_TOKEN=your_green_api_token
WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=TojikAI SMM Platform
APP_VERSION=3.0.0
ENVIRONMENT=production  # development, staging, production
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_EMPIRE_GAME=true
ENABLE_AI_CONSULTANT=true
ENABLE_MARKETPLACE=false
ENABLE_ANALYTICS=true
ENABLE_WHITE_LABEL=true

# ============================================================================
# ADMIN SETTINGS
# ============================================================================
ADMIN_EMAIL=admin@tojikai.app
ADMIN_PHONE=+992910000000
SUPPORT_EMAIL=support@tojikai.app
SUPPORT_PHONE=+992910000000

# ============================================================================
# CORS SETTINGS
# ============================================================================
ALLOWED_ORIGINS=https://web.telegram.org,https://t.me,http://localhost:3000

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# ============================================================================
# EMAIL SETTINGS (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@tojikai.app

# ============================================================================
# SENTRY (Error Tracking - Optional)
# ============================================================================
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
